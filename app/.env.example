# Address of the deployed BountyEscrow contract on Studionet.
# The app already falls back to this address if the variable is left empty,
# so you only need a .env file to point at a different deployment.
#
# To deploy your own, from the project root:
#   python scripts/bundle.py
#   genlayer network set studionet
#   genlayer deploy --contract dist/bounty_escrow.bundle.py
# then paste the printed address below.
VITE_CONTRACT_ADDRESS=0xFF9461802642D8D065D4e685a97653D35701Cfe1

# Optional: override the human-readable network label shown in the UI.
VITE_NETWORK_LABEL=Studionet
